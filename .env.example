# Senhas da stack local (troque antes de expor qualquer porta)
POSTGRES_PASSWORD=zabbix
GRAFANA_ADMIN_PASSWORD=admin

# Credenciais que o zbxctl e o Grafana usam na API do Zabbix.
# Em produção, prefira ZABBIX_API_TOKEN (Users > API tokens) e troque a senha do Admin.
ZABBIX_USER=Admin
ZABBIX_PASSWORD=zabbix
# ZABBIX_API_TOKEN=

# Alertas no Telegram: crie um bot com o @BotFather e pegue o chat id com o @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcional: exige token para usar os botões de caos da loja demo
# Token para automações mudarem o modo da loja (o CI usa). Vazio desliga esse caminho.
CHAOS_TOKEN=
# Login do painel de caos. Sem senha, o app gera uma e mostra no log do container.
DEMO_EMAIL=admin@sistema.demo
DEMO_PASSWORD=
# true quando o painel estiver atrás de HTTPS.
COOKIE_SECURE=false
